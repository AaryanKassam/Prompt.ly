# Copy to .env and fill in. .env is gitignored — never commit real keys.
#
# Enables the two optional LLM features (prompt rewrite + Execute playbook).
# Everything else works without it.
ANTHROPIC_API_KEY=sk-ant-...

# Force the offline path even when a key is present.
# PROMPTLY_DISABLE_LLM=1

# Postgres instead of the default local SQLite.
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/promptly
