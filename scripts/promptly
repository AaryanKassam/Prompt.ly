#!/usr/bin/env python3
"""`promptly` launcher.

Symlink this onto your PATH so the CLI works from any project directory:

    ln -s "$PWD/scripts/promptly" /usr/local/bin/promptly

It re-execs under the repo's virtualenv when one exists, so the command works
regardless of which Python is active in the caller's environment — VS Code,
a Claude Code hook and a plain shell all arrive here with different PATHs.
"""
from __future__ import annotations

import os
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
VENV_DIR = REPO_ROOT / "backend" / "venv"
VENV_PYTHON = VENV_DIR / "bin" / "python"

# Set once before re-exec so a misconfigured venv can never loop forever.
_REEXEC_FLAG = "PROMPTLY_REEXECED"


def _already_in_venv() -> bool:
    """True when this interpreter is the repo venv's.

    Compares sys.prefix rather than resolving sys.executable: a venv's
    bin/python is a symlink to the *base* interpreter, so resolving both sides
    collapses them to the same file and falsely reports a match. sys.prefix is
    the venv directory itself and has no such ambiguity.
    """
    try:
        return Path(sys.prefix).resolve() == VENV_DIR.resolve()
    except OSError:
        return False


if VENV_PYTHON.exists() and not _already_in_venv() and not os.environ.get(_REEXEC_FLAG):
    os.environ[_REEXEC_FLAG] = "1"
    os.execv(str(VENV_PYTHON), [str(VENV_PYTHON), __file__, *sys.argv[1:]])

sys.path.insert(0, str(REPO_ROOT))

try:
    from backend.cli import main
except ModuleNotFoundError as exc:
    sys.exit(
        f"promptly: missing dependency '{exc.name}'.\n"
        f"Running under: {sys.executable}\n"
        f"Expected venv: {VENV_PYTHON}\n\n"
        "Install the backend dependencies:\n"
        f"  {VENV_PYTHON} -m pip install fastapi uvicorn sqlalchemy python-dotenv rich"
    )

if __name__ == "__main__":
    sys.exit(main())
